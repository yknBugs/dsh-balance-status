{
  "name": "dsh-balance-status",
  "version": "1.0.0",
  "description": "在 DSH Web 底部状态行（x 轮 x 步 · tok/s · tok · 缓存命中）之后追加 DeepSeek 账户余额，左键单击弹出用量详情",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "balance"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
